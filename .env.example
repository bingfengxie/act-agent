# ---- Tracing ----
# act-agent 的 RunContext 含不可序列化对象；如需 LangSmith 追踪请显式开启并自行评估数据外发
LANGCHAIN_TRACING_V2=false

# ---- LLM ----
# openai 兼容网关（DeepSeek / 通义 / vLLM 等）或 anthropic
ACT_AGENT_LLM_PROVIDER=openai
ACT_AGENT_LLM_MODEL=deepseek-chat
ACT_AGENT_LLM_BASE_URL=https://api.deepseek.com
# 留空时依次回退到 DEEPSEEK_API_KEY / OPENAI_API_KEY
ACT_AGENT_LLM_API_KEY=
ACT_AGENT_LLM_TEMPERATURE=0

# ---- Auth ----
ACT_AGENT_JWT_SECRET=please-change-me-in-production
ACT_AGENT_JWT_EXPIRE_MINUTES=720
ACT_AGENT_BOOTSTRAP_ADMIN_USERNAME=admin
ACT_AGENT_BOOTSTRAP_ADMIN_PASSWORD=admin123
ACT_AGENT_BOOTSTRAP_TENANT=default

# ---- Storage ----
# 元数据（租户/会话/审计）库；生产用 Postgres
ACT_AGENT_DATABASE_URL=postgresql+asyncpg://act:act@localhost:5432/act_agent
# LangGraph checkpoint 库；留空则使用 InMemorySaver（仅开发）
ACT_AGENT_CHECKPOINT_DSN=postgresql://act:act@localhost:5432/act_agent
# 会话级分布式锁：pg | memory
ACT_AGENT_LOCK_BACKEND=pg

# ---- Skills ----
ACT_AGENT_SKILLS_DIR=../act-skills

# ---- MCP ----
ACT_AGENT_MCP_CONFIG_PATH=config/mcp.json
ACT_AGENT_MCP_TOOL_TIMEOUT_SECONDS=60

# ---- Context compression ----
ACT_AGENT_MAX_CONTEXT_TOKENS=64000
ACT_AGENT_COMPRESS_RATIO=0.6
ACT_AGENT_KEEP_RECENT_MESSAGES=20

# ---- Server ----
ACT_AGENT_HOST=0.0.0.0
ACT_AGENT_PORT=8088
ACT_AGENT_LOG_LEVEL=INFO
